<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud API keys stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud_keys.xml" />
    </device-transfer>
</data-extraction-rules>
