<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext HTTP is permitted so that this app can talk to a self-hosted
        backend on a private network without TLS termination.
        If you expose your endpoint over HTTPS, you can tighten this further.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
